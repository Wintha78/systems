			"type": "text",
			"x": 2075,
			"y": 175,
			"width": 259.71875,
			"height": 448,
			"angle": 0,
			"strokeColor": "#1c2b3a",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
