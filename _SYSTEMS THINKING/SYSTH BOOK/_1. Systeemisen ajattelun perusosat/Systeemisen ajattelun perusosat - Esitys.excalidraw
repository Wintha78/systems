			"isDeleted": false,
			"boundElements": [],
			"updated": 1778759011787,
			"link": null,
			"locked": false,
			"text": "Syy ja seuraus eivät\nkohtaa ajallisesti\ntai paikallisesti\n\nEsimerkki:\nTermostaatti — viive\n→ ylikuumeneminen\n→ viilennys\n→ liian kylmä\n→ heilahtelukierre\n\nRatkaisu:\n● Tunnista viiveet\n● Älä reagoi liian\n  nopeasti\n● Siedä tilapäinen\n  paheneminen\n● Kärsivällisyys!\n\n⚠ Muutos voi näyttää\nhuonolta ennen kuin\nse paranee",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Syy ja seuraus eivät\nkohtaa ajallisesti\ntai paikallisesti\n\nEsimerkki:\nTermostaatti — viive\n→ ylikuumeneminen\n→ viilennys\n→ liian kylmä\n→ heilahtelukierre\n\nRatkaisu:\n● Tunnista viiveet\n● Älä reagoi liian\n  nopeasti\n● Siedä tilapäinen\n  paheneminen\n● Kärsivällisyys!\n\n⚠ Muutos voi näyttää\nhuonolta ennen kuin\nse paranee",
			"lineHeight": 1.4,
			"autoResize": true,
			"index": "al",
			"hasTextLink": false,
			"rawText": ""
		},
