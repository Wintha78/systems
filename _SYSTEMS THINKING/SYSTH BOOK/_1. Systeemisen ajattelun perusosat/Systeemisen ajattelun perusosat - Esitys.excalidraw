		{
			"id": "f2-ld",
			"type": "text",
			"x": 1445,
			"y": 175,
			"width": 277.40625,
			"height": 425.59999999999997,
			"angle": 0,
			"strokeColor": "#1c2b3a",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": "f2",
			"roundness": null,
			"seed": 206,
			"version": 2,
			"versionNonce": 1195599664,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778759011787,
			"link": null,
			"locked": false,
			"text": "Holismi — kyky tarkastella järjestelmää\nyhtenäisenä kokonaisuutena\n\n● Laajentava (sweeping) ajattelu\n  vs. reduktivinen osiin paloittelu\n\n● Kokonaisuus on ENEMMÄN\n  kuin osiensa summa\n\n● Synteesi: näe osat JA kokonaisuus\n  samanaikaisesti\n\n● Emergenttiys: osien vuorovaikutus\n  tuottaa uusia ominaisuuksia\n  (esim. lämpötila = atomien liike)\n\n● Perifeerinen näkökyky:\n  katsoo laajasti ja näkee\n  piilevät syy-seuraussuhteet",
			"fontSize": 16,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Holismi — kyky tarkastella järjestelmää\nyhtenäisenä kokonaisuutena\n\n● Laajentava (sweeping) ajattelu\n  vs. reduktivinen osiin paloittelu\n\n● Kokonaisuus on ENEMMÄN\n  kuin osiensa summa\n\n● Synteesi: näe osat JA kokonaisuus\n  samanaikaisesti\n\n● Emergenttiys: osien vuorovaikutus\n  tuottaa uusia ominaisuuksia\n  (esim. lämpötila = atomien liike)\n\n● Perifeerinen näkökyky:\n  katsoo laajasti ja näkee\n  piilevät syy-seuraussuhteet",
			"lineHeight": 1.4,
			"autoResize": true,
			"index": "aO",
			"hasTextLink": false,
			"rawText": ""
		},
