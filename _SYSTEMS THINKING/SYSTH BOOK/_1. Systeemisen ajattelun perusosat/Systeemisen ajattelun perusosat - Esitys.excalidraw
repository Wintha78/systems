			"groupIds": [],
			"frameId": "f2",
			"roundness": null,
			"seed": 209,
			"version": 2,
			"versionNonce": 77654480,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778759011787,
			"link": null,
			"locked": false,
			"text": "Järjestelmän ydin ei ole osissa\nvaan niiden VÄLISESSÄ yhteydessä\n\n● Kaikki osat riippuvat toisistaan\n  ja laajemmasta kokonaisuudesta\n\n● Ilman vuorovaikutusta:\n  vain irrallinen kokoelma,\n  ei järjestelmä\n\n● Ekosysteemi: eläimet, kasvit,\n  ilma, vesi — yhden pettäessä\n  koko systeemi vaarantuu\n\n● Ongelmat eivät esiinny\n  tyhjiössä — aina osa\n  laajempia verkostoja\n\n● Muutos yhdessä osassa\n  heijastuu kaikkialle",
			"fontSize": 16,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Järjestelmän ydin ei ole osissa\nvaan niiden VÄLISESSÄ yhteydessä\n\n● Kaikki osat riippuvat toisistaan\n  ja laajemmasta kokonaisuudesta\n\n● Ilman vuorovaikutusta:\n  vain irrallinen kokoelma,\n  ei järjestelmä\n\n● Ekosysteemi: eläimet, kasvit,\n  ilma, vesi — yhden pettäessä\n  koko systeemi vaarantuu\n\n● Ongelmat eivät esiinny\n  tyhjiössä — aina osa\n  laajempia verkostoja\n\n● Muutos yhdessä osassa\n  heijastuu kaikkialle",
			"lineHeight": 1.4,
			"autoResize": true,
			"index": "aR",
			"hasTextLink": false,
			"rawText": ""
